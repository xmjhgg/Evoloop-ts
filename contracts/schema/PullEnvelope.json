{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "envelopes": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "serverSequence": {
            "type": "string",
            "maxLength": 30,
            "pattern": "^(0|[1-9]\\d*)$"
          },
          "batch": {
            "type": "object",
            "properties": {
              "protocolVersion": {
                "type": "string",
                "const": "1"
              },
              "batchId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "deviceId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "expectedHeadVersion": {
                "type": "string",
                "maxLength": 30,
                "pattern": "^(0|[1-9]\\d*)$"
              },
              "payloadSchemaVersion": {
                "type": "string",
                "const": "documents-v1"
              },
              "changes": {
                "minItems": 1,
                "maxItems": 2000,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "table": {
                      "type": "string",
                      "enum": [
                        "profile.condition",
                        "profile.observation",
                        "planning.goal",
                        "planning.week",
                        "planning.guard",
                        "planning.candidate",
                        "execution.fact",
                        "execution.food-draft",
                        "review.document",
                        "review.adjustment",
                        "system.token",
                        "system.revision"
                      ]
                    },
                    "id": {
                      "minLength": 1,
                      "maxLength": 240,
                      "type": "string"
                    },
                    "before": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "accountId": {
                              "type": "string",
                              "format": "uuid",
                              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                            },
                            "id": {
                              "minLength": 1,
                              "maxLength": 240,
                              "type": "string"
                            },
                            "version": {
                              "type": "string",
                              "maxLength": 30,
                              "pattern": "^(0|[1-9]\\d*)$"
                            },
                            "revisionId": {
                              "type": "string",
                              "format": "uuid",
                              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                            },
                            "data": {
                              "minLength": 2,
                              "maxLength": 1048576,
                              "type": "string"
                            }
                          },
                          "required": [
                            "accountId",
                            "id",
                            "version",
                            "revisionId",
                            "data"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "after": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "accountId": {
                              "type": "string",
                              "format": "uuid",
                              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                            },
                            "id": {
                              "minLength": 1,
                              "maxLength": 240,
                              "type": "string"
                            },
                            "version": {
                              "type": "string",
                              "maxLength": 30,
                              "pattern": "^(0|[1-9]\\d*)$"
                            },
                            "revisionId": {
                              "type": "string",
                              "format": "uuid",
                              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                            },
                            "data": {
                              "minLength": 2,
                              "maxLength": 1048576,
                              "type": "string"
                            }
                          },
                          "required": [
                            "accountId",
                            "id",
                            "version",
                            "revisionId",
                            "data"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "table",
                    "id",
                    "before",
                    "after"
                  ],
                  "additionalProperties": false
                }
              },
              "payloadDigest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "protocolVersion",
              "batchId",
              "deviceId",
              "expectedHeadVersion",
              "payloadSchemaVersion",
              "changes",
              "payloadDigest"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "serverSequence",
          "batch"
        ],
        "additionalProperties": false
      }
    },
    "nextSequence": {
      "type": "string",
      "maxLength": 30,
      "pattern": "^(0|[1-9]\\d*)$"
    },
    "headVersion": {
      "type": "string",
      "maxLength": 30,
      "pattern": "^(0|[1-9]\\d*)$"
    }
  },
  "required": [
    "envelopes",
    "nextSequence",
    "headVersion"
  ],
  "additionalProperties": false
}
