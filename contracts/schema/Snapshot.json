{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "snapshotId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "baseSequence": {
      "type": "string",
      "maxLength": 30,
      "pattern": "^(0|[1-9]\\d*)$"
    },
    "payloadSchemaVersion": {
      "type": "string",
      "const": "documents-v1"
    },
    "chunks": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "string",
            "maxLength": 30,
            "pattern": "^(0|[1-9]\\d*)$"
          },
          "data": {
            "minLength": 2,
            "maxLength": 1048576,
            "type": "string"
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "index",
          "data",
          "digest"
        ],
        "additionalProperties": false
      }
    },
    "attachments": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "complete": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "digest",
          "complete"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "snapshotId",
    "baseSequence",
    "payloadSchemaVersion",
    "chunks",
    "attachments"
  ],
  "additionalProperties": false
}
