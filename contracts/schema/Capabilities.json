{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "syncProtocolVersions": {
      "type": "array",
      "items": {
        "type": "string",
        "const": "1"
      }
    },
    "payloadSchemaVersions": {
      "type": "array",
      "items": {
        "type": "string",
        "const": "documents-v1"
      }
    },
    "headVersion": {
      "type": "string",
      "maxLength": 30,
      "pattern": "^(0|[1-9]\\d*)$"
    },
    "rootInitialized": {
      "type": "boolean"
    },
    "snapshotId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "snapshotSequence": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 30,
          "pattern": "^(0|[1-9]\\d*)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "maxChanges": {
      "type": "string",
      "const": "2000"
    },
    "maxBytes": {
      "type": "string",
      "const": "8388608"
    }
  },
  "required": [
    "syncProtocolVersions",
    "payloadSchemaVersions",
    "headVersion",
    "rootInitialized",
    "snapshotId",
    "snapshotSequence",
    "maxChanges",
    "maxBytes"
  ],
  "additionalProperties": false
}
