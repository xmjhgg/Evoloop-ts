{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "accountId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "username": {
      "type": "string"
    },
    "aiAllowed": {
      "type": "boolean"
    },
    "healthAllowed": {
      "type": "boolean"
    },
    "purposeVersion": {
      "type": "string",
      "maxLength": 30,
      "pattern": "^(0|[1-9]\\d*)$"
    }
  },
  "required": [
    "accountId",
    "username",
    "aiAllowed",
    "healthAllowed",
    "purposeVersion"
  ],
  "additionalProperties": false
}
